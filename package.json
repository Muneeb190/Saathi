{
  "name": "saathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=backend/.env --import tsx --watch backend/server/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "tsc -b && tsc --noEmit -p backend/tsconfig.server.json && vite build --config frontend/vite.config.ts",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "oxlint",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=backend/.env --import tsx backend/server/index.ts",
    "test": "node --import tsx --test frontend/src/simulation.test.ts frontend/src/speech.test.ts backend/server/speech.test.ts backend/server/assistant.test.ts shared/interactive-lessons.test.ts shared/learner-state.test.ts"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.65.0",
    "node-edge-tts": "^1.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
